# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local

# drizzle
/drizzle/meta

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# lighthouse (루트의 산출물만. 워크플로 파일 lighthouse.yml 은 걸리지 않게 루트에 고정)
/lighthouse.*
.lighthouseci/

# 로컬에 설치한 외부 스킬 (리포에 싣지 않는다. 이 리포 전용 스킬은 무시하지 않는다)
/.agents/skills/neon-postgres/
/.claude/skills/neon-postgres
skills-lock.json

# ops (independent repo)
/ops

# GJC workflow state
.gjc/
