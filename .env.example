# =========================================
# Ourfolio 프로젝트 전용 → .env.local로 복사하세요
# cp .env.example .env.local
# 공통 키(R2 계정, Slack, Sentry 등)는 direnv가 root .env에서 자동 로드
# =========================================

# Neon (Ourfolio DB)
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/ourfolio?sslmode=require"

# BetterAuth
BETTER_AUTH_SECRET=""   # openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# R2 (Ourfolio 버킷)
R2_BUCKET_NAME="ourfolio-images"
R2_ENDPOINT=""   # https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=""   # https://images.ourfolio.com

# Resend (Ourfolio 발신자)
RESEND_API_KEY=""
RESEND_FROM="Ourfolio <noreply@ourfolio.com>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# GitHub OAuth (W4 — repo import). Create a GitHub OAuth App; scope read:user.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Sentry — client DSN must be public (server SENTRY_DSN/ORG/AUTH_TOKEN load from root .env)
NEXT_PUBLIC_SENTRY_DSN=""
